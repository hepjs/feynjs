% SUSY-2013-20 fig_01b: squark pair, two steps via sleptons: squark -> q chargino1 / q neutralino2, then -> l/nu slepton/sneutrino -> l/nu neutralino1
layout: v2
arrows: none
in: p1 p2
out: q1 a1 a2 n1 n2 b2 b1 q2
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [squark] s1
pp -- [squark] s2
s1 -- q1 [q]
s1 -- [chargino] c1
c1 -- a1 [\nu/\ell]
c1 -- [slepton, label=\tilde\ell/\tilde\nu] l1
l1 -- a2 [\ell/\nu]
l1 -- n1 [neutralino1]
s2 -- [neutralino2] x2
x2 -- [slepton, label=\tilde\ell/\tilde\nu] l2
l2 -- n2 [neutralino1]
l2 -- b2 [\ell/\nu]
x2 -- b1 [\ell/\nu]
s2 -- q2 [q]
