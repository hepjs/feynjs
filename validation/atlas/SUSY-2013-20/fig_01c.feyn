% SUSY-2013-20 fig_01c: squark pair, two steps via W and Z: squark -> q chargino1, chargino1 -> W neutralino2, neutralino2 -> Z neutralino1
layout: v2
arrows: none
in: p1 p2
out: q1 w1 z1 n1 n2 z2 w2 q2
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [squark] s1
pp -- [squark] s2
s1 -- q1 [q]
s1 -- [chargino] c1
c1 -- w1 [W]
c1 -- [neutralino2] x1
x1 -- z1 [Z]
x1 -- n1 [neutralino1]
s2 -- [chargino, label=\tilde\chi^\mp_1] c2
c2 -- [neutralino2] x2
x2 -- n2 [neutralino1]
x2 -- z2 [Z]
c2 -- w2 [W]
s2 -- q2 [q]
