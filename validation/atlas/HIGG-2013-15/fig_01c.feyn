% HIGG-2013-15 fig_01c: qqbar -> V* -> VH, V -> qqbar, H -> WW* -> lnu lnu (opposite-sign 2l channel)
layout: v2
in: qb q
out: q3 q2 n1 l1 n0 l0
q [q] -- [fermion] a -- [fermion] qb [\bar q]
a -- [boson, label={W^\pm/Z^0}] b
b -- [boson, label={W^\pm/Z^0}] z
b -- [scalar, label'=H^0] h
q3 [\bar q] -- [fermion] z -- [fermion] q2 [q]
h -- [boson, label=W^\pm] w1
h -- [boson, label'=W^\mp] w2
l1 [\ell_1^\pm] -- [fermion] w1 -- [fermion] n1 [\bar\nu]
n0 [\bar\nu] -- [fermion] w2 -- [fermion] l0 [\ell_0^\mp]
