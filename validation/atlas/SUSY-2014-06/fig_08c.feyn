% SUSY-2014-06 fig_08c: gluino pair via off-shell stop/sbottom, gluino -> t b chargino, chargino -> f f' neutralino1 (off-shell W)
layout: v2
arrows: none
in: p1 p2
out: t1 b1 f1 f2 n1 n2 f3 f4 b2 t2
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [gluino] g1 [dot, color=gray]
pp -- [gluino] g2 [dot, color=gray]
g1 -- t1 [t]
g1 -- b1 [b]
g1 -- [chargino, label=\tilde\chi^\pm] c1 [dot, color=gray]
c1 -- f1 [f']
c1 -- f2 [f]
c1 -- n1 [neutralino1]
g2 -- [chargino, label=\tilde\chi^\pm] c2 [dot, color=gray]
c2 -- n2 [neutralino1]
c2 -- f3 [f]
c2 -- f4 [f']
g2 -- b2 [b]
g2 -- t2 [t]
