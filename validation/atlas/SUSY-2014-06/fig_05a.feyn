% SUSY-2014-06 fig_05a: squark pair, two-step decays via chargino1/neutralino2 and sleptons/sneutrinos to neutralino1
layout: v2
arrows: none
in: p1 p2
out: q1 a1 a2 n1 n2 b2 b1 q2
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [squark] s1
pp -- [squark] s2
s1 -- q1 [q]
s1 -- [chargino] c
c -- a1 [\nu/\ell]
c -- [slepton, label=\tilde\ell/\tilde\nu] l1
l1 -- a2 [\ell/\nu]
l1 -- n1 [neutralino1]
s2 -- [neutralino2] x
x -- [slepton, label=\tilde\ell/\tilde\nu] l2
l2 -- n2 [neutralino1]
l2 -- b2 [\ell/\nu]
x -- b1 [\ell/\nu]
s2 -- q2 [q]
