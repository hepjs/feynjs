% SUSY-2014-06 fig_04b: gluino pair, one-step decay gluino -> q q chargino, chargino -> W neutralino1
layout: v2
arrows: none
in: p1 p2
out: q1 q2 w1 n1 n2 w2 q3 q4
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [gluino] x1 [dot, color=gray]
pp -- [gluino] x2 [dot, color=gray]
x1 -- q1 [q]
x1 -- q2 [q]
x1 -- [chargino] c1
c1 -- w1 [W]
c1 -- n1 [neutralino1]
x2 -- [chargino, label=\tilde\chi^\mp_1] c2
c2 -- n2 [neutralino1]
c2 -- w2 [W]
x2 -- q3 [q]
x2 -- q4 [q]
