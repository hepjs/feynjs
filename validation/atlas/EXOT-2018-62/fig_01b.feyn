in: g1 g2
out: q x xb qb
g1 [particle={g}]
g2 [particle={g}]
a [dot]
b [dot]
c [dot]
q [particle={b/t}]
qb [particle={\bar{b}/\bar{t}}]
x [particle={\chi}]
xb [particle={\bar{\chi}}]
g1 -- [gluon] a
g2 -- [gluon] b
b -- [fermion] a
a -- [fermion] q
c -- [fermion] b
