% HDBS-2018-19 fig_01 (b): HVT W' produced via vector-boson fusion, W' -> WZ -> l nu l l
layout: v2
in: i1 i2
out: o1 f1 f2 f3 f4 o2
i1 [q] -- [fermion, color=#232f9c] a -- [fermion, color=#232f9c] o1 [q]
i2 [q] -- [fermion, color=#232f9c] c -- [fermion, color=#232f9c] o2 [q]
a -- [boson, color=#5aa02c] v
c -- [boson, color=#5aa02c] v
v -- [W', color=#5aa02c] b
b -- [Z, color=#5aa02c] z
b -- [W, label'=W, color=#5aa02c] w
z -- [color=#232f9c] f1 [l+]
z -- [color=#232f9c] f2 [l-]
w -- [anti fermion, color=#232f9c] f3 [\ell^\pm]
w -- [color=#232f9c] f4 [nu]
