% EXOT-2014-08 fig_01b: heavy lepton pair, q qbar' > W+ > L+ N0, L+ > l+ Z(> l+ l-), N0 > (l, nu, nu) (W, Z, H)
layout: v2
in: i1 i2
out: lp1 lm1 lp2 x v
i1 [q] -- [fermion] a
a -- [fermion] i2 [\overline{q}']
a -- [boson, label=W^+] b
c -- [fermion, label=L^+] b
b -- [fermion, label=N^0] d
c -- [boson, label=Z] z
lp1 [l^+] -- [fermion] z
z -- [fermion] lm1 [l^-]
lp2 [l^+] -- [fermion] c
d -- [fermion] x [{l^\pm, \nu, \nu}]
d -- [boson] v [{W^\mp, Z, H}]
