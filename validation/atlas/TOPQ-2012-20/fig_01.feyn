% TOPQ-2012-20 fig_01: tW production and dilepton decay, gb -> b -> tW-, colour-coded lines without arrows
layout: v2
in: i1 i2
out: f1 f2 f3 f4 f5
i1 [g] -- [gluon] v1
i2 [b] -- [plain, color=#1e88e5] v1 -- [plain, color=#1e88e5] v2 -- [plain, label=t, color=red] v3
v3 -- [boson, label=W^+] w1
w1 -- [plain, color=#22cc22] f1 [\ell^+]
w1 -- [plain, color=#22cc22] f2 [\nu]
v3 -- [plain, color=#1e88e5] f3 [b]
v2 -- [boson, label=W^-] w2
w2 -- [plain, color=#22cc22] f4 [\ell^-]
w2 -- [plain, color=#22cc22] f5 [\bar\nu]
