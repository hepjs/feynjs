f1 [b] -- [fermion] a1
a1 -- [sbottom, charged scalar, label'=\tilde b] a2
f2 [b] -- [fermion] a2
a2 -- f3 [neutralino1]
b1 -- f8 [t]
b2 -- [stop, charged scalar, label=\bar{\tilde t}] b1
b2 -- f7 [b]
b3 -- [chargino-, label=\tilde\chi_1^-] b2
b3 -- f6 [l-]
b4 -- [sneutrino, charged scalar, label=\bar{\tilde\nu}^*] b3
b4 -- f5 [nu]
b4 -- f4 [neutralino1]
