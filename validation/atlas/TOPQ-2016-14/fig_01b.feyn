i2 -- [gluon, color=blue] vg [dot, color=red]
f4 [\bar b] -- [fermion, color=magenta] vg -- [fermion, label=b, color=magenta] v2 -- [fermion, color=red] vt [dot, color=red] -- [fermion, color=red] f3 [t]
vt -- [boson, color=red] f2 [Z]
