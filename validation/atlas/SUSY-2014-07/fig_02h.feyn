d2 -- [plain] b2
d1 -- [susy fermion, label'={\tilde{\chi}^0_2}] e1
e1 -- [susy fermion] n1
d2 -- [susy fermion, label={\tilde{\chi}^0_2}] e2
e2 -- [susy fermion] n2
e1 -- [scalar] h1
