out: b1 h1 n1 n2 h2 b2
pp [blob]
p1 [particle={p}]
p2 [particle={p}]
b1 [particle={b}]
b2 [particle={b}]
h1 [particle={h}]
h2 [particle={h}]
n1 [particle={\tilde{\chi}^0_1}]
n2 [particle={\tilde{\chi}^0_1}]
