% SUSY-2014-07 fig_02d: stop pair, four-body stop -> b f f' neutralino1
layout: v2
arrows: none
in: p1 p2
out: b1 f1 f2 n1 n2 f3 f4 b2
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [stop] s1 [dot, color=gray]
pp -- [stop] s2 [dot, color=gray]
s1 -- b1 [b]
s1 -- f1 [f]
s1 -- f2 [f']
s1 -- n1 [neutralino1]
s2 -- n2 [neutralino1]
s2 -- f3 [f'']
s2 -- f4 [f''']
s2 -- b2 [b]
