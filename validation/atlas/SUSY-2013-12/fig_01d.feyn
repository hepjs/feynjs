pp -- [chargino] c
pp -- [neutralino2] x
c -- [W] w
w -- l1 [\ell]
w -- nu [\nu]
c -- n1 [neutralino1]
x -- n2 [neutralino1]
x -- [h] h [dot, color=gray]
h -- l2 [\ell]
h -- l3 [\ell]
