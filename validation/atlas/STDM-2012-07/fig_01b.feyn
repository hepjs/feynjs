% STDM-2012-07 fig_01b: W/Z + photon, t-channel: photon from the incoming quark, W(Z) -> l nu (l l, nu nu)
layout: v2
in: qb q
out: nb l g
q [q] -- [fermion] a -- [fermion] b -- [fermion] qb [qbar]
a -- [photon] g [gamma]
b -- [scalar, label'=W(Z)] w
w -- [fermion] l [{l(l,\nu)}]
nb [{\bar\nu(\bar l,\bar\nu)}] -- [fermion] w
