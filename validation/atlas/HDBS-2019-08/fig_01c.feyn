% HDBS-2019-08 fig_01c: gg -> A via a quark triangle, A -> ZH, Z -> jj/ll/invisible, H -> ZZ -> 4l
layout: v2
in: i1 i2
out: f1 f2 f3 f4 f5 f6
i1 [g] -- t1
i2 [g] -- t2
t2 -- [fermion] t1 -- [fermion] t3 -- [fermion] t2
t3 -- [A] a
a -- [Z] z0
a -- [H, label'=H] h
f2 [j/\ell^+/\text{inv}] -- [fermion] z0 -- [fermion] f1 [j/\ell^-/\text{inv}]
h -- [Z] z1
h -- [Z] z2
z1 -- f3 [l+]
z1 -- f4 [l-]
z2 -- f5 [l+]
z2 -- f6 [l-]
