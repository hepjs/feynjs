% SUSY-2013-13 fig_01a: chargino pair, chargino -> W neutralino1, neutralino1 -> l l nu via RPV lambda
layout: v2
arrows: none
in: p1 p2
out: w1 a1 a2 a3 b1 b2 b3 w2
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [chargino] c1
pp -- [chargino, label=\tilde\chi^\mp_1] c2
c1 -- w1 [W]
c1 -- [neutralino1] n1 [dot, color=#2457f5, size=1.3, label=\lambda]
n1 -- a1 [\ell]
n1 -- a2 [\ell]
n1 -- a3 [\nu]
c2 -- [neutralino1] n2 [dot, color=#2457f5, size=1.3, label=\lambda]
n2 -- b1 [\nu]
n2 -- b2 [\ell]
n2 -- b3 [\ell]
c2 -- w2 [W]
