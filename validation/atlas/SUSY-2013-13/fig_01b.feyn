n1 -- a1 [\ell]
n1 -- a2 [\ell]
n1 -- a3 [\nu]
s2 -- [neutralino1] n2 [empty dot, color=blue, label=\lambda]
n2 -- b1 [\nu]
n2 -- b2 [\ell]
n2 -- b3 [\ell]
