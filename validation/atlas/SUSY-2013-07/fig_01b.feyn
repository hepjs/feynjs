% SUSY-2013-07 fig_01b: gluino pair, each gluino -> q q neutralino, neutralino -> q q q via RPV lambda''
layout: v2
arrows: none
in: p1 p2
out: q1 q2 a1 a2 a3 b1 b2 b3 q3 q4
p1 [p] -- pp [blob]
p2 [p] -- pp
pp -- [gluino] g1 [dot, color=gray]
pp -- [gluino] g2 [dot, color=gray]
g1 -- q1 [q]
g1 -- q2 [q]
g1 -- [neutralino1] n1 [empty dot, color=blue, label=\lambda'']
n1 -- a1 [q]
n1 -- a2 [q]
n1 -- a3 [q]
g2 -- [neutralino1] n2 [empty dot, color=blue, label=\lambda'']
n2 -- b1 [q]
n2 -- b2 [q]
n2 -- b3 [q]
g2 -- q3 [q]
g2 -- q4 [q]
