% HDBS-2018-13 fig_01c: gluon fusion via a quark triangle to A, A -> ZH, Z -> l+l-, H -> W+W- -> 4q
layout: v2
in: i1 i2
out: f1 f2 f3 f4 f5 f6
i1 [g] -- t1
i2 [g] -- t2
t2 -- [fermion] t1 -- [fermion] t3 -- [fermion] t2
t3 -- [A, label'=A] a
a -- [Z] z
a -- [H] h
z -- f1 [l-]
z -- f2 [l+]
h -- [W-] wm
h -- [W+] wp
wm -- f3 [q]
wm -- f4 [qbar]
wp -- f5 [q]
wp -- f6 [qbar]
