% EXOT-2013-22 fig_01a: FRVZ model, H > f_d2 f_d2, each f_d2 > HLSP gamma_d, gamma_d > l+ l-
layout: v2
in: h
out: s1 l1 l2 s2 l3 l4
h [H] -- [scalar] a
a -- [plain, label=f_{d_2}] b
a -- [plain, label'=f_{d_2}] c
b -- [plain] s1 [\mathrm{HLSP}]
b -- [photon, label=\gamma_d] g1
g1 -- [plain] l1 [l+]
g1 -- [plain] l2 [l-]
c -- [plain] s2 [\mathrm{HLSP}]
c -- [photon, label'=\gamma_d] g2
g2 -- [plain] l3 [l+]
g2 -- [plain] l4 [l-]
